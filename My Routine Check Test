function toLocalDateStr(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function mondayStr(d){var x=new Date(d);var day=(x.getDay()+6)%7;x.setDate(x.getDate()-day);return toLocalDateStr(x)}
function periodKey(reset,date){var d=date||new Date();if(reset==='daily')return toLocalDateStr(d);if(reset==='weekly')return 'W'+mondayStr(d);if(reset==='monthly')return 'M'+d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');if(reset==='yearly')return 'Y'+d.getFullYear();return 'always'}
function defaultData(){return seedData()}
function seedData(){
  var d=JSON.parse(JSON.stringify(SEED_DATA));
  // 元アプリで非表示にした固定タスクは、テスト版でも最初から除外する (読み取り専用)
  try{
    var hidden=JSON.parse(localStorage.getItem('hidden_tasks_v1')||'[]');
    if(Array.isArray(hidden)&&hidden.length){
      var hs={}; hidden.forEach(function(x){hs[String(x)]=1});
      d.tasks=d.tasks.filter(function(t){return !hs[t.id]});
    }
  }catch(e){}
  // 元アプリで自分で追加したタスク (マイタスク) を取り込む (読み取り専用・元データは変更しない)
  try{
    var raw=localStorage.getItem('my_tasks_v1');
    if(raw){
      var parsed=JSON.parse(raw);
      var byName={}; d.categories.forEach(function(c){byName[c.name]=c.id});
      var used={}; d.tasks.forEach(function(t){used[t.id]=1});
      var addOne=function(item,catName){
        if(!item)return;
        var name='',note='';
        if(typeof item==='string'){name=item}
        else{name=item.name||item.text||item.title||'';note=item.note||item.memo||'';catName=catName||item.section||item.category||item.cat}
        name=String(name).trim(); if(!name)return;
        var cid=byName[catName]||byName['今日やる'];
        var id=(item&&item.id&&!used[item.id])?String(item.id):uid('t');
        used[id]=1;
        d.tasks.push({id:id,name:name,note:String(note).trim(),categoryId:cid});
      };
      if(Array.isArray(parsed)){parsed.forEach(function(it){addOne(it,null)})}
      else if(parsed&&typeof parsed==='object'){Object.keys(parsed).forEach(function(k){var v=parsed[k];if(Array.isArray(v))v.forEach(function(it){addOne(it,k)});else addOne(v,k)})}
    }
  }catch(e){}
  return d;
}

function loadData(){try{var raw=localStorage.getItem(STORE_KEY);if(!raw)return defaultData();var d=JSON.parse(raw);if(!d||!Array.isArray(d.categories)||!Array.isArray(d.tasks))return defaultData();d.checked=d.checked||{};d.history=d.history||{};return d}catch(e){return defaultData()}}
function saveData(d){try{localStorage.setItem(STORE_KEY,JSON.stringify(d))}catch(e){}}
var data=loadData();
function catById(id){return data.categories.find(function(c){return c.id===id})}
function isDone(task){var cat=catById(task.categoryId);if(!cat)return false;return data.checked[task.id]===periodKey(cat.reset)}
function reportTasks(){var daily=data.tasks.filter(function(t){var c=catById(t.categoryId);return c&&c.reset==='daily'});return daily.length?daily:data.tasks}
function updateTodayHistory(){var list=reportTasks();var today=toLocalDateStr(new Date());var per={},names={};var done=0;list.forEach(function(t){var d=isDone(t);per[t.id]=d;names[t.id]=t.name;if(d)done++});data.history[today]={total:list.length,done:done,per:per,names:names};var keys=Object.keys(data.history).sort();if(keys.length>90)keys.slice(0,keys.length-90).forEach(function(k){delete data.history[k]})}
</script>
<script>
var taskSortables={},catSortable=null;
function render(){
  var now=new Date();var dn=['日','月','火','水','木','金','土'];
  document.getElementById('header-date').textContent=(now.getMonth()+1)+'月'+now.getDate()+'日（'+dn[now.getDay()]+'）';
  renderTaskForm();renderSections();renderManage();updateTodayHistory();saveData(data);
}
function renderTaskForm(){
  var sel=document.getElementById('task-category');var prev=sel.value;
  if(!data.categories.length){sel.innerHTML='<option value="">カテゴリなし</option>';document.getElementById('task-add-btn').disabled=true;document.getElementById('task-form-hint').textContent='先に「カテゴリ管理」タブでカテゴリを作ってください。';return}
  document.getElementById('task-add-btn').disabled=false;document.getElementById('task-form-hint').textContent='';
  sel.innerHTML=data.categories.map(function(c){return '<option value="'+c.id+'">'+esc(c.name)+'</option>'}).join('');
  if(catById(prev))sel.value=prev;
}
function renderSections(){
  var wrap=document.getElementById('sections');var empty=document.getElementById('empty-state');
  var total=data.tasks.length;var done=data.tasks.filter(isDone).length;
  document.getElementById('progress-text').textContent=done+' / '+total+' 完了';
  document.getElementById('progress-fill').style.width=(total?Math.round(done/total*100):0)+'%';
  if(!data.categories.length){wrap.innerHTML='';empty.innerHTML='<div class="empty-box"><b>まだ何もありません</b><br>最初にカテゴリを作るところから始められます。<br>例：今日やる ／ 特別 ／ 朝 ／ 夜 など<br><br><button class="primary-btn" onclick="switchTab(\'manage\')">カテゴリを作る</button></div>';return}
  empty.innerHTML='';
  wrap.innerHTML=data.categories.map(function(cat){
    var tasks=data.tasks.filter(function(t){return t.categoryId===cat.id});
    var cards=tasks.map(function(t){
      var d=isDone(t);
      return '<div class="task-card'+(d?' done':'')+'" data-id="'+t.id+'" style="background:'+esc(cat.color||'#fff')+'" onclick="toggleTask(\''+t.id+'\')">'
      +'<div class="task-checkbox"></div><span class="task-name">'+esc(t.name)+'</span>'
      +(t.note?'<span class="task-note">'+esc(t.note)+'</span>':'')
      +'<button class="icon-btn edit" title="編集" onclick="event.stopPropagation();editTask(\''+t.id+'\')">✎</button>'
      +'<button class="icon-btn" title="削除" onclick="event.stopPropagation();deleteTask(\''+t.id+'\')">×</button></div>';
    }).join('');
    return '<div class="section"><div class="section-title">'+esc(cat.name)+' <span class="reset-badge">'+esc(RESET_LABELS[cat.reset]||'')+'</span></div>'
      +'<div class="task-list" data-cat="'+cat.id+'">'+cards+'</div>'
      +(tasks.length?'':'<div class="empty-note">タスクがありません（上のフォームから追加できます）</div>')+'</div>';
  }).join('');
  initTaskSortables();
}
function initTaskSortables(){
  Object.keys(taskSortables).forEach(function(k){try{taskSortables[k].destroy()}catch(e){}});taskSortables={};
  if(typeof Sortable==='undefined')return;
  document.querySelectorAll('.task-list').forEach(function(el){
    taskSortables[el.dataset.cat]=Sortable.create(el,{animation:150,delay:450,delayOnTouchOnly:true,
      onEnd:function(){
        var catId=el.dataset.cat;var order=[].map.call(el.querySelectorAll('[data-id]'),function(c){return c.dataset.id});
        var inCat=data.tasks.filter(function(t){return t.categoryId===catId});
        inCat.sort(function(a,b){return order.indexOf(a.id)-order.indexOf(b.id)});
        var rest=data.tasks.filter(function(t){return t.categoryId!==catId});
        var rebuilt=[];data.categories.forEach(function(c){rebuilt=rebuilt.concat(c.id===catId?inCat:rest.filter(function(t){return t.categoryId===c.id}))});
        data.tasks=rebuilt;saveData(data);
      }});
  });
}
</script>
<script>
function toggleTask(id){var t=data.tasks.find(function(x){return x.id===id});if(!t)return;var cat=catById(t.categoryId);if(!cat)return;var key=periodKey(cat.reset);if(data.checked[id]===key)delete data.checked[id];else data.checked[id]=key;render()}
function addTask(){var name=document.getElementById('task-name').value.trim();var catId=document.getElementById('task-category').value;if(!name||!catId)return;data.tasks.push({id:uid('t'),name:name,note:document.getElementById('task-note').value.trim(),categoryId:catId});document.getElementById('task-name').value='';document.getElementById('task-note').value='';render();document.getElementById('task-name').focus()}
function editTask(id){var t=data.tasks.find(function(x){return x.id===id});if(!t)return;var name=prompt('タスク名',t.name);if(name===null)return;name=name.trim();if(!name)return;var note=prompt('メモ（任意）',t.note||'');if(note===null)return;t.name=name;t.note=note.trim();render()}
function deleteTask(id){var t=data.tasks.find(function(x){return x.id===id});if(!t)return;if(!confirm('「'+t.name+'」を削除しますか？'))return;data.tasks=data.tasks.filter(function(x){return x.id!==id});delete data.checked[id];render()}
function resetToday(){if(!confirm('今日リセット対象のチェックをすべて外しますか？'))return;data.tasks.forEach(function(t){var c=catById(t.categoryId);if(c&&c.reset==='daily')delete data.checked[t.id]});render()}
function switchTab(name){document.querySelectorAll('.tab').forEach(function(t){t.classList.toggle('active',t.dataset.tab===name)});document.querySelectorAll('.tab-content').forEach(function(c){c.classList.remove('active')});document.getElementById('tab-'+name).classList.add('active');if(name==='report')renderReport();window.scrollTo(0,0)}
document.querySelectorAll('.tab').forEach(function(tab){tab.addEventListener('click',function(){switchTab(tab.dataset.tab)})});
function addCategory(){var name=document.getElementById('cat-name').value.trim();if(!name)return;data.categories.push({id:uid('c'),name:name,reset:document.getElementById('cat-reset').value,color:selectedColor});document.getElementById('cat-name').value='';render()}
function deleteCategory(id){var c=catById(id);if(!c)return;var n=data.tasks.filter(function(t){return t.categoryId===id}).length;if(!confirm('カテゴリ「'+c.name+'」を削除しますか？'+(n?' 中のタスク '+n+' 件も削除されます。':'')))return;data.tasks.filter(function(t){return t.categoryId===id}).forEach(function(t){delete data.checked[t.id]});data.tasks=data.tasks.filter(function(t){return t.categoryId!==id});data.categories=data.categories.filter(function(x){return x.id!==id});render()}
function renameCategory(id){var c=catById(id);if(!c)return;var name=prompt('カテゴリ名',c.name);if(name===null)return;name=name.trim();if(!name)return;c.name=name;render()}
function moveCategory(id,dir){var i=data.categories.findIndex(function(c){return c.id===id});var j=i+dir;if(i<0||j<0||j>=data.categories.length)return;var tmp=data.categories[i];data.categories[i]=data.categories[j];data.categories[j]=tmp;render()}
function setCatColor(id,color){var c=catById(id);if(c){c.color=color;render()}}
function setCatReset(id,val){var c=catById(id);if(c){c.reset=val;render()}}
</script>
<script>
function renderManage(){
  var chips=document.getElementById('preset-chips');
  chips.innerHTML=PRESETS.map(function(p){return '<button class="chip" onclick="fillPreset(\''+p+'\')">'+p+'</button>'}).join('');
  var sw=document.getElementById('cat-swatches');
  sw.innerHTML=PALETTE.map(function(col){return '<span class="swatch'+(col===selectedColor?' selected':'')+'" style="background:'+col+'" onclick="pickColor(\''+col+'\')"></span>'}).join('');
  var list=document.getElementById('category-list');var empty=document.getElementById('category-empty');
  if(!data.categories.length){list.innerHTML='';empty.innerHTML='<div class="empty-note" style="text-align:center;padding:16px 0">まだカテゴリがありません。上のフォームから作ってください。</div>';return}
  empty.innerHTML='';
  list.innerHTML=data.categories.map(function(cat,i){
    var count=data.tasks.filter(function(t){return t.categoryId===cat.id}).length;
    var swatches=PALETTE.map(function(col){return '<span class="swatch'+(col===cat.color?' selected':'')+'" style="background:'+col+'" onclick="setCatColor(\''+cat.id+'\',\''+col+'\')"></span>'}).join('');
    var opts=Object.keys(RESET_LABELS).map(function(k){return '<option value="'+k+'"'+(cat.reset===k?' selected':'')+'>'+RESET_LABELS[k]+'</option>'}).join('');
    return '<div class="cat-card" data-id="'+cat.id+'"><div class="cat-card-main">'
      +'<span class="drag-handle" title="ドラッグで並び替え">⠿</span>'
      +'<span class="cat-name">'+esc(cat.name)+'</span><span class="cat-count">'+count+' 件</span>'
      +'<button class="mini-btn" onclick="moveCategory(\''+cat.id+'\',-1)">↑</button>'
      +'<button class="mini-btn" onclick="moveCategory(\''+cat.id+'\',1)">↓</button>'
      +'<button class="mini-btn" onclick="renameCategory(\''+cat.id+'\')">✎</button>'
      +'<button class="mini-btn" onclick="deleteCategory(\''+cat.id+'\')">×</button></div>'
      +'<div class="cat-card-sub"><div class="swatches">'+swatches+'</div>'
      +'<select onchange="setCatReset(\''+cat.id+'\',this.value)">'+opts+'</select></div></div>';
  }).join('');
  if(typeof Sortable!=='undefined'){
    if(catSortable){try{catSortable.destroy()}catch(e){}}
    catSortable=Sortable.create(list,{animation:150,handle:'.drag-handle',
      onEnd:function(){var order=[].map.call(list.querySelectorAll('[data-id]'),function(c){return c.dataset.id});data.categories.sort(function(a,b){return order.indexOf(a.id)-order.indexOf(b.id)});saveData(data);renderSections();renderTaskForm()}});
  }
}
function fillPreset(name){document.getElementById('cat-name').value=name;document.getElementById('cat-name').focus()}
function pickColor(col){selectedColor=col;renderManage()}
function exportData(){var blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='my-routine-test-backup.json';a.click();setTimeout(function(){URL.revokeObjectURL(a.href)},2000)}
function importData(ev){var f=ev.target.files[0];if(!f)return;var r=new FileReader();r.onload=function(){try{var d=JSON.parse(r.result);if(!d||!Array.isArray(d.categories)||!Array.isArray(d.tasks))throw new Error('bad');d.checked=d.checked||{};d.history=d.history||{};if(!confirm('今のデータを、読み込んだデータで置き換えますか？'))return;data=d;saveData(data);render();alert('読み込みました')}catch(e){alert('読み込めませんでした。書き出したファイルを選んでください')}};r.readAsText(f);ev.target.value=''}
function clearAll(){if(!confirm('カテゴリ・タスク・記録をすべて削除して、空の状態に戻しますか？'))return;if(!confirm('本当に削除しますか？ 元に戻せません。'))return;data={categories:[],tasks:[],checked:{},history:{}};saveData(data);render()}
</script>
<script>
var reportPeriod=7;var DAY_NAMES=['日','月','火','水','木','金','土'];
function setReportPeriod(days,btn){reportPeriod=days;document.querySelectorAll('.report-period-btn').forEach(function(b){b.classList.remove('active')});btn.classList.add('active');renderReport()}
function renderReport(){
  var el=document.getElementById('report-content');if(!el)return;
  var today=new Date();var days=[];
  for(var i=reportPeriod-1;i>=0;i--){var d=new Date(today);d.setDate(d.getDate()-i);days.push(toLocalDateStr(d))}
  var recorded=days.filter(function(d){return data.history[d]&&data.history[d].total>0});
  if(!recorded.length){el.innerHTML='<div class="report-empty">📊 まだデータがありません<br>タスクをチェックすると記録が溜まります</div>';return}
  var bars=recorded.map(function(ds){var rec=data.history[ds];var pct=rec.total?Math.round(rec.done/rec.total*100):0;var d=new Date(ds+'T12:00:00');var label=(d.getMonth()+1)+'/'+d.getDate()+'('+DAY_NAMES[d.getDay()]+')';var cls=pct<50?'low':pct<75?'mid':'';
    return '<div class="report-day-row"><span class="report-day-label">'+label+'</span><div class="report-bar-wrap"><div class="report-bar-fill '+cls+'" style="width:'+pct+'%"></div></div><span class="report-pct">'+pct+'%</span></div>'}).join('');
  var stats={};
  recorded.forEach(function(ds){var rec=data.history[ds];Object.keys(rec.per||{}).forEach(function(id){if(!stats[id])stats[id]={name:(rec.names&&rec.names[id])||'（削除済み）',days:0,done:0};stats[id].days++;if(rec.per[id])stats[id].done++})});
  var arr=Object.keys(stats).map(function(id){var s=stats[id];s.pct=s.days?Math.round(s.done/s.days*100):0;return s}).filter(function(s){return s.days>=2});
  var low=arr.slice().sort(function(a,b){return a.pct-b.pct}).slice(0,7);
  var high=arr.slice().sort(function(a,b){return b.pct-a.pct}).slice(0,5);
  var row=function(t){var cls=t.pct<50?'low':t.pct<75?'mid':'high';return '<div class="report-task-row"><span class="report-task-name">'+esc(t.name)+'</span><span class="report-task-pct '+cls+'">'+t.pct+'%</span></div>'};
  var avg=Math.round(recorded.reduce(function(s,ds){var r=data.history[ds];return s+(r.total?r.done/r.total*100:0)},0)/recorded.length);
  el.innerHTML='<div class="report-section"><div class="report-section-title">📊 日別達成率（平均 '+avg+'%）</div>'+bars+'</div>'
    +'<div class="report-section"><div class="report-section-title">⚠️ サボりがちタスク</div>'+(low.length?low.map(row).join(''):'<div class="report-empty">データなし</div>')+'</div>'
    +'<div class="report-section"><div class="report-section-title">🏆 よくできてるタスク</div>'+(high.length?high.map(row).join(''):'<div class="report-empty">データなし</div>')+'</div>';
}
document.getElementById('task-name').addEventListener('keydown',function(e){if(e.key==='Enter')addTask()});
document.getElementById('task-note').addEventListener('keydown',function(e){if(e.key==='Enter')addTask()});
document.getElementById('cat-name').addEventListener('keydown',function(e){if(e.key==='Enter')addCategory()});
render();
</script>
