<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',sans-serif;background:#f5f5f5;color:#333;-webkit-tap-highlight-color:transparent}
header{background:#4caf50;color:#fff;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 4px rgba(0,0,0,.2)}
header h1{font-size:1.3rem}
header span{font-size:.85rem;opacity:.9}
.tabs{display:flex;background:#fff;border-bottom:2px solid #e0e0e0;overflow-x:auto;position:sticky;top:0;z-index:20}
.tab{padding:12px 18px;cursor:pointer;white-space:nowrap;font-size:.9rem;border-bottom:3px solid transparent}
.tab.active{border-bottom-color:#4caf50;color:#4caf50;font-weight:600}
.container{max-width:700px;margin:0 auto;padding:16px}
.tab-content{display:none}.tab-content.active{display:block}
.progress-wrap{background:#fff;border-radius:10px;padding:14px 16px;margin-bottom:16px;box-shadow:0 1px 3px rgba(0,0,0,.1)}
.progress-label{display:flex;justify-content:space-between;font-size:.85rem;color:#666;margin-bottom:8px}
.progress-bar{height:8px;background:#e0e0e0;border-radius:4px;overflow:hidden}
.progress-fill{height:100%;background:#4caf50;border-radius:4px;transition:width .3s}
.section{margin-bottom:20px}
.section-title{font-size:.85rem;font-weight:700;color:#777;letter-spacing:.06em;margin-bottom:8px;padding-left:4px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.reset-badge{font-size:.65rem;font-weight:400;color:#fff;background:#a5d6a7;padding:1px 7px;border-radius:8px;letter-spacing:0}
.task-list{display:flex;flex-direction:column;gap:6px}
.task-card{background:#fff;border-radius:8px;padding:12px 14px;box-shadow:0 1px 3px rgba(0,0,0,.1);display:flex;align-items:center;gap:10px;cursor:pointer;user-select:none;transition:opacity .2s}
.task-card.done{opacity:.45}.task-card.done .task-name{text-decoration:line-through}
.task-checkbox{width:22px;height:22px;border:2px solid #ccc;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:.75rem;color:#fff}
.task-card.done .task-checkbox{background:#4caf50;border-color:#4caf50}
.task-card.done .task-checkbox::after{content:'✓'}
.task-name{flex:1;font-size:.95rem;font-weight:500;word-break:break-word}
.task-note{font-size:.75rem;color:#999;white-space:nowrap}
.icon-btn{background:none;border:none;color:#ccc;font-size:1rem;cursor:pointer;padding:2px 4px;flex-shrink:0;line-height:1}
.icon-btn:hover{color:#e53935}.icon-btn.edit:hover{color:#4caf50}
.empty-note{font-size:.82rem;color:#bbb;padding:6px 4px}
.empty-box{background:#fff;border-radius:10px;padding:28px 18px;text-align:center;color:#999;box-shadow:0 1px 3px rgba(0,0,0,.08);margin-bottom:16px;line-height:1.8;font-size:.92rem}
.empty-box b{color:#555}
.primary-btn{padding:10px 18px;background:#4caf50;color:#fff;border:none;border-radius:8px;font-size:.9rem;cursor:pointer;font-weight:600}
.primary-btn:hover{background:#43a047}
.reset-btn{width:100%;padding:10px;background:#fff;border:1px solid #e0e0e0;border-radius:8px;color:#bbb;cursor:pointer;font-size:.85rem;margin-top:4px}
.reset-btn:hover{background:#fff3e0;color:#e65100;border-color:#ffcc80}
</style>
<style>
.form-box{background:#fff;border-radius:10px;padding:14px 16px;margin-bottom:16px;box-shadow:0 1px 3px rgba(0,0,0,.1)}
.form-title{font-size:.8rem;font-weight:700;color:#999;letter-spacing:.08em;margin-bottom:10px}
.form-row{display:flex;gap:8px;margin-bottom:8px}
.form-row:last-child{margin-bottom:0}
select,input[type=text]{padding:9px 10px;border:1px solid #ddd;border-radius:8px;font-size:.9rem;background:#f9f9f9;color:#333;min-width:0}
input[type=text]{flex:1;background:#fff}
select:focus,input[type=text]:focus{outline:none;border-color:#4caf50}
.add-btn{padding:9px 18px;background:#4caf50;color:#fff;border:none;border-radius:8px;font-size:.9rem;cursor:pointer;font-weight:600;white-space:nowrap}
.add-btn:hover{background:#43a047}
.add-btn:disabled{background:#ccc;cursor:default}
.hint{font-size:.78rem;color:#aaa;line-height:1.7;margin:6px 2px 14px}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}
.chip{font-size:.78rem;padding:5px 11px;border-radius:16px;border:1px solid #ddd;background:#fafafa;color:#666;cursor:pointer}
.chip:hover{border-color:#4caf50;color:#4caf50}
.swatches{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.swatch{width:28px;height:28px;border-radius:50%;border:2px solid #e0e0e0;cursor:pointer;flex-shrink:0}
.swatch.selected{border-color:#333;transform:scale(1.12)}
.cat-card{background:#fff;border-radius:10px;padding:12px 14px;box-shadow:0 1px 3px rgba(0,0,0,.1);margin-bottom:8px}
.cat-card-main{display:flex;align-items:center;gap:8px}
.drag-handle{cursor:grab;color:#bbb;font-size:1.15rem;padding:4px 2px;touch-action:none;flex-shrink:0}
.cat-name{flex:1;font-size:.98rem;font-weight:600;word-break:break-word}
.cat-count{font-size:.75rem;color:#999;white-space:nowrap}
.mini-btn{background:#f5f5f5;border:1px solid #e0e0e0;border-radius:6px;width:30px;height:30px;font-size:.85rem;cursor:pointer;color:#666;flex-shrink:0}
.mini-btn:hover{background:#e8f5e9;color:#2e7d32}
.cat-card-sub{display:flex;align-items:center;gap:8px;margin-top:10px;flex-wrap:wrap}
.cat-card-sub .swatch{width:22px;height:22px}
.cat-card.sortable-ghost{opacity:.4}
.data-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.ghost-btn{padding:9px 14px;background:#fff;border:1px solid #ddd;border-radius:8px;font-size:.85rem;cursor:pointer;color:#666}
.ghost-btn.danger{color:#c62828;border-color:#ef9a9a}
.report-period-btns{display:flex;gap:8px;margin-bottom:16px}
.report-period-btn{padding:6px 16px;border-radius:20px;border:1px solid #ddd;background:#fff;font-size:.85rem;cursor:pointer;color:#666}
.report-period-btn.active{background:#4caf50;color:#fff;border-color:#4caf50;font-weight:600}
.report-section{margin-bottom:22px}
.report-section-title{font-size:.8rem;font-weight:700;color:#999;letter-spacing:.08em;margin-bottom:10px}
.report-day-row{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.report-day-label{font-size:.8rem;color:#666;width:56px;flex-shrink:0;text-align:right}
.report-bar-wrap{flex:1;background:#f0f0f0;border-radius:6px;height:18px;overflow:hidden}
.report-bar-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,#66bb6a,#43a047)}
.report-bar-fill.low{background:linear-gradient(90deg,#ef9a9a,#e53935)}
.report-bar-fill.mid{background:linear-gradient(90deg,#ffcc80,#fb8c00)}
.report-pct{font-size:.8rem;font-weight:700;color:#555;width:38px;flex-shrink:0}
.report-task-row{display:flex;align-items:center;gap:10px;background:#fff;border-radius:8px;padding:9px 13px;margin-bottom:6px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.report-task-name{flex:1;font-size:.9rem}
.report-task-pct{font-size:.85rem;font-weight:700;padding:2px 10px;border-radius:10px}
.report-task-pct.low{background:#ffebee;color:#e53935}.report-task-pct.mid{background:#fff3e0;color:#e65100}.report-task-pct.high{background:#e8f5e9;color:#2e7d32}
.report-empty{text-align:center;color:#bbb;font-size:.9rem;padding:30px 0;line-height:1.8}
</style>
</head>
<body>
<header><h1>デイリールーティン <span style="font-size:.75rem;background:#fff;color:#2e7d32;border-radius:10px;padding:2px 9px;vertical-align:middle">テスト版</span></h1><span id="header-date"></span></header>
<div class="tabs">
  <div class="tab active" data-tab="today">今日</div>
  <div class="tab" data-tab="report">レポート</div>
  <div class="tab" data-tab="manage">カテゴリ管理</div>
</div>
<div class="container">
  <div class="tab-content active" id="tab-today">
    <div class="hint" style="margin:0 2px 12px">テスト版です。今までのタスクを初期データとして入れてあります。保存先は元のアプリとは別なので、元のアプリのデータは上書きされません。</div>
    <div class="form-box">
      <div class="form-title">タスクを追加</div>
      <div class="form-row">
        <select id="task-category" aria-label="カテゴリ"></select>
        <input type="text" id="task-name" placeholder="タスク名...">
      </div>
      <div class="form-row">
        <input type="text" id="task-note" placeholder="メモ（任意）例: 13:00 / お風呂後">
        <button class="add-btn" id="task-add-btn" onclick="addTask()">追加</button>
      </div>
      <div class="hint" id="task-form-hint"></div>
    </div>
    <div class="progress-wrap">
      <div class="progress-label"><span>今日の進捗</span><span id="progress-text">0 / 0 完了</span></div>
      <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
    </div>
    <div id="empty-state"></div>
    <div id="sections"></div>
    <button class="reset-btn" onclick="resetToday()">今日のチェックをリセット</button>
    <div class="hint">タスクは長押しドラッグで並び替えできます。カテゴリの順番は「カテゴリ管理」タブで変えられます。</div>
  </div>

  <div class="tab-content" id="tab-report">
    <div class="report-period-btns">
      <button class="report-period-btn active" onclick="setReportPeriod(7,this)">過去7日</button>
      <button class="report-period-btn" onclick="setReportPeriod(30,this)">過去30日</button>
    </div>
    <div id="report-content"></div>
  </div>

  <div class="tab-content" id="tab-manage">
    <div class="form-box">
      <div class="form-title">カテゴリを作る</div>
      <div class="chips" id="preset-chips"></div>
      <div class="form-row">
        <input type="text" id="cat-name" placeholder="カテゴリ名 例: 今日やる">
      </div>
      <div class="form-row">
        <select id="cat-reset" aria-label="リセット周期">
          <option value="daily">毎日リセット</option>
          <option value="weekly">週間（月曜リセット）</option>
          <option value="monthly">月間（月が変わるとリセット）</option>
          <option value="yearly">年間（年が変わるとリセット）</option>
          <option value="never">リセットしない（チェックが残る）</option>
        </select>
      </div>
      <div class="form-row" style="align-items:center;justify-content:space-between">
        <div class="swatches" id="cat-swatches"></div>
        <button class="add-btn" onclick="addCategory()">追加</button>
      </div>
      <div class="hint">「今日やる」「特別」のようなカテゴリも、名前を入力すれば自由に作れます。色とリセット周期はあとからも変更できます。</div>
    </div>
    <div class="form-title" style="padding-left:2px">カテゴリの順番（⠿ をドラッグ、または ↑ ↓ で入れ替え）</div>
    <div id="category-list"></div>
    <div id="category-empty"></div>
    <div class="form-box" style="margin-top:20px">
      <div class="form-title">データの管理</div>
      <div class="hint" style="margin-top:0">入力したカテゴリ・タスク・チェックは、このスマホのブラウザに保存されます。機種変更のときは書き出して移してください。</div>
      <div class="data-row">
        <button class="ghost-btn" onclick="exportData()">データを書き出す</button>
        <button class="ghost-btn" onclick="document.getElementById('import-file').click()">データを読み込む</button>
        <button class="ghost-btn danger" onclick="clearAll()">すべて削除して空に戻す</button>
      </div>
      <input type="file" id="import-file" accept=".json,application/json" style="display:none" onchange="importData(event)">
    </div>
  </div>
</div>
